{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassagent.local/schemas/capability-vocabulary-v1.json",
  "title": "Capability vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabularyVersion", "hardware", "brokerCapabilities"],
  "properties": {
    "vocabularyVersion": { "const": 1 },
    "hardware": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "privacyClass", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/hardwareId" },
          "privacyClass": { "enum": ["NORMAL", "MEDIA", "BIOMETRIC"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "brokerCapabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "sideEffect", "requiresHardware", "dryRun", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "status": { "enum": ["AVAILABLE", "PLANNED"] },
          "sideEffect": { "enum": ["NONE", "USER_OUTPUT", "EXTERNAL"] },
          "requiresHardware": {
            "type": "object", "additionalProperties": false, "required": ["all", "anyOf"],
            "properties": {
              "all": { "type": "array", "items": { "$ref": "#/$defs/hardwareId" }, "uniqueItems": true },
              "anyOf": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hardwareId" } } }
            }
          },
          "dryRun": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  },
  "$defs": {
    "hardwareId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$", "maxLength": 64 }
  }
}
