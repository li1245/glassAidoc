{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassagent.local/schemas/skill-manifest-v2.json",
  "title": "SkillManifest v2",
  "description": "v1 的超集：新增 SCRIPT_BUNDLE、硬件声明、触发条件、运行限制与隐私声明。manifest 不得包含密钥或个人记忆文本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "skillKey", "displayName", "version", "kind", "sdkApiVersion",
               "inputSchema", "outputSchema", "requiredCapabilities", "hardware", "triggers",
               "limits", "privacy", "maxSideEffect"],
  "properties": {
    "manifestVersion": { "const": 2 },
    "skillKey": { "type": "string", "minLength": 2, "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["WORKFLOW", "JVM_JAR", "SCRIPT_BUNDLE"] },
    "sdkApiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "engine", "entry"],
      "properties": {
        "language": { "const": "typescript" },
        "engine": { "enum": ["node22"] },
        "entry": { "type": "string", "maxLength": 200, "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.m?js$" }
      }
    },
    "entrypoint": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$" },
    "inputSchema": { "$ref": "#/$defs/objectSchema" },
    "outputSchema": { "$ref": "#/$defs/objectSchema" },
    "requiredCapabilities": {
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hardwareId" }, "default": [] },
        "optional": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hardwareId" }, "default": [] },
        "anyOf": {
          "type": "array", "default": [],
          "description": "至少有一组完整可用即可，例如语音输出或显示输出二选一",
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hardwareId" } }
        }
      }
    },
    "triggers": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["type", "examples"],
            "properties": {
              "type": { "const": "intent" },
              "examples": { "type": "array", "minItems": 1, "maxItems": 10,
                            "items": { "type": "string", "minLength": 1, "maxLength": 200 } } } },
          { "type": "object", "additionalProperties": false,
            "required": ["type", "scene", "cooldownSeconds", "maxPerHour"],
            "properties": {
              "type": { "const": "scene" },
              "scene": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40 },
              "onEvent": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 64 },
              "cooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
              "maxPerHour": { "type": "integer", "minimum": 1, "maximum": 120 } } },
          { "type": "object", "additionalProperties": false,
            "required": ["type", "event", "cooldownSeconds", "maxPerHour"],
            "properties": {
              "type": { "const": "event" },
              "event": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 64 },
              "cooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
              "maxPerHour": { "type": "integer", "minimum": 1, "maximum": 120 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "cron", "maxPerDay"],
            "properties": {
              "type": { "const": "schedule" },
              "cron": { "type": "string", "minLength": 9, "maxLength": 64 },
              "maxPerDay": { "type": "integer", "minimum": 1, "maximum": 96 } } }
        ]
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeoutMs", "memoryMb", "maxOutputBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "memoryMb": { "type": "integer", "minimum": 32, "maximum": 1024 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["dataClasses", "readsPersonalMemory", "storesPersonalData", "retainsRawMedia"],
      "properties": {
        "dataClasses": { "type": "array", "uniqueItems": true, "items": { "enum": ["NORMAL", "MEDIA", "BIOMETRIC"] } },
        "readsPersonalMemory": { "type": "boolean" },
        "storesPersonalData": { "const": false },
        "retainsRawMedia": { "const": false }
      }
    },
    "maxSideEffect": { "enum": ["NONE", "USER_OUTPUT", "EXTERNAL"] }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "SCRIPT_BUNDLE" } } },
      "then": { "required": ["runtime"], "not": { "required": ["entrypoint"] } } },
    { "if": { "properties": { "kind": { "const": "JVM_JAR" } } },
      "then": { "required": ["entrypoint"], "not": { "required": ["runtime"] } } },
    { "if": { "properties": { "kind": { "const": "WORKFLOW" } } },
      "then": { "not": { "anyOf": [ { "required": ["entrypoint"] }, { "required": ["runtime"] } ] } } }
  ],
  "$defs": {
    "hardwareId": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$" },
    "objectSchema": {
      "type": "object", "required": ["type"],
      "properties": { "type": { "const": "object" }, "$schema": { "type": "string" } }
    }
  }
}
